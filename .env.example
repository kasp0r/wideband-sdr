# Copy this file to `.env` and edit the values, or set them directly in your
# environment. docker-compose reads `.env` for variable substitution; the
# backend also reads these variables from the process environment.

# ---- rtl_tcp SDR server ----
SDR_HOST=127.0.0.1
SDR_PORT=1234

# ---- SDR / DSP ----
SAMPLE_RATE=2400000
FFT_SIZE=8192
AVERAGES=2
SPECTRUM_BINS=2048
MIN_SPAN_HZ=250000
DEFAULT_FREQ=100000000
DEFAULT_GAIN=auto
DEFAULT_DEMOD=wfm
AUTO_CONNECT=1
FREQ_CORRECTION=0

# ---- hardware limits ----
MIN_SAMPLE_RATE=225001
MAX_SAMPLE_RATE=3200000
MIN_GAIN_DB=0.0
MAX_GAIN_DB=50.0
SCAN_MAX_WALL_TIME=120

# ---- reconnect backoff (seconds) ----
RECONNECT_DELAY=2
RECONNECT_MAX_DELAY=30

# ---- Ollama ----
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest
OLLAMA_TIMEOUT=180
MAX_HISTORY_MESSAGES=40
MAX_SIGNALS=10
METRICS_INTERVAL=4
